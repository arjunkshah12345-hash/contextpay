# PayPal sandbox app (developer.paypal.com > Apps & Credentials). Enable "Save payment methods".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Set PAYPAL_MODE=mock to simulate PayPal without credentials.
# Live money also needs CONTEXTPAY_ALLOW_LIVE=1; without it, live is ignored.

# Claude purchasing planner (falls back to a heuristic without it)
ANTHROPIC_API_KEY=
# PLANNER_MODEL=claude-opus-5-5
# PLANNER=heuristic

# SuperCompress (falls back to a local filter without it; COMPRESS_ENGINE=local forces the filter)
SUPERCOMPRESS_API_KEY=

PORT=4242
# PUBLIC_URL=http://localhost:4242          # absolute base for PayPal return URLs (Render sets RENDER_EXTERNAL_URL)
# AGENT_TOKEN=                              # if set, agents must send "Authorization: Bearer <token>"
# APPROVAL_TTL_MINUTES=30                   # unanswered approvals expire after this
# ALLOW_DEMO_AGENT=1                        # "Run the demo agent" button on the dashboard
# ALLOW_RESET=1                             # "Reset demo" button on the dashboard
# CREDIT_PRICE_PER_MTOK=                    # demo credit rate per 1M tokens (see src/mandate.js)
# DOWNSTREAM_PRICE_PER_MTOK=                # downstream model input price per 1M tokens, used for ROI
